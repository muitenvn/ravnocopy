    <string name="vpn_mode_bypass_desc">Desbloqueo regional directo en el navegador (menor latencia, sin proxy).</string>
    <string name="vpn_mode_vpn_proxy_desc">Proxy aislado solo para dominios Xbox. Excluye inicio de sesión y datos del teléfono.</string>
    <string name="vpn_mode_vpn_external_desc">Usa tu app VPN del dispositivo (Warp, Proton…). Gestionado por Android.</string>
