    <string name="vpn_mode_switched_external_toast">✓ Modo: Proxy (VPN externa)</string>
    <string name="vpn_security_confirm_title">¿Cambiar al modo Proxy?</string>
    <string name="vpn_security_confirm_message">• El Proxy en la app está aislado estrictamente dentro de Ravno: no accede a datos del teléfono, excluye el inicio de sesión de Microsoft y redes locales, se pausa en segundo plano y bloquea y desconecta automáticamente cualquier proxy con errores SSL o redirecciones externas.\n\n• Las apps de VPN externa funcionan a nivel del sistema Android, por lo que Ravno no puede inspeccionar ni bloquear su tráfico.\n\n• Los servidores proxy públicos y VPN de terceros envían tráfico a través de terceros. Al continuar, aceptas estos riesgos bajo tu total responsabilidad en el modo Proxy.</string>
    <string name="vpn_security_confirm_accept">Entiendo, bajo mi responsabilidad</string>
    <string name="vpn_security_confirm_cancel">Cancelar (Seguir en Bypass)</string>
    <string name="vpn_security_killswitch_title">Proxy bloqueado por seguridad</string>
    <string name="vpn_security_killswitch_ssl_msg">El proxy %1$s provocó un error de certificado SSL (%2$s). Ravno bloqueó la conexión, desconectó el Proxy y puso este servidor en cuarentena.</string>
    <string name="vpn_security_killswitch_external_msg">El proxy %1$s intentó redirigir fuera de los dominios confiables (%2$s). Ravno bloqueó la ruta, desconectó el Proxy y puso este servidor en cuarentena.</string>
    <string name="vpn_security_killswitch_ok">Entendido (Seguir en Bypass)</string>
    <string name="vpn_server_security_blocked_badge">Bloqueado por seguridad</string>
    <string name="vpn_server_security_blocked_toast">Este proxy fue bloqueado por seguridad. Elige otro servidor o desbloquéalo.</string>
    <string name="vpn_security_unblock_action">Desbloquear</string>
    <string name="vpn_security_isolation_banner">El proxy en la app solo enruta dominios Xbox, excluye el inicio de sesión y bloquea redirecciones inseguras.</string>
    <string name="vpn_external_os_notice">La VPN externa funciona a nivel de Android. Ravno no puede inspeccionar ni bloquear su tráfico.</string>
